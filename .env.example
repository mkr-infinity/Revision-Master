# ------------------------------------------------------------------
# Revision Master — environment variables
# Copy to `.env` and fill in. `.env*` is git-ignored.
# ------------------------------------------------------------------

# Google Gemini (existing AI features)
VITE_GEMINI_API_KEY=

# ------------------------------------------------------------------
# Social sign-in (login screen)
# Leave blank to run the login screen in local "demo" mode.
# Full setup walkthrough: AUTH_SETUP.md
# ------------------------------------------------------------------

# Google OAuth 2.0 → Web application client ID
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# Authorised JavaScript origins must include every URL you run the app from
# (http://localhost:5000, https://your-domain.com, …)
VITE_GOOGLE_CLIENT_ID=

# Sign in with Apple → Services ID (e.g. app.revisionmaster.web)
# Apple Developer → Certificates, Identifiers & Profiles → Identifiers → Services IDs
# Enable "Sign in with Apple", then add the Return URL below as a domain/return URL.
VITE_APPLE_CLIENT_ID=

# Return URL for Apple (must match the Services ID config exactly).
VITE_APPLE_REDIRECT_URI=http://localhost:5000/auth/callback
